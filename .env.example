# Copy this file to .env on the server and fill in the values:
#   cp .env.example .env
# .env is never committed to git.

# Where the server listens (Nginx forwards the domain to this address)
PORT=3000
HOST=127.0.0.1

# SMS panel: "parsgreen" for real SMS, "console" to print codes in the log (testing)
SMS_PROVIDER=console

# Parsgreen web-service key (from the «وب‌سرویس» menu in the Parsgreen panel)
PARSGREEN_API_KEY=
# Adds your panel's company name to the OTP message
PARSGREEN_ADD_NAME=true

# Code lifetime and limits
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_IP_SENDS_PER_HOUR=10
OTP_MOBILE_SENDS_PER_DAY=8

# Random secret used to hash codes in memory. Any long random text.
OTP_SECRET=change-me-to-a-long-random-string

# Set to true when running behind Nginx so rate limits see the real visitor IP
TRUST_PROXY=true

# Name shown after login until identity services are connected
DEMO_USER_NAME=دکتر پرهام جلالی
