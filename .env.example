# Copy this file to .env on the server and fill in the values:
#   cp .env.example .env
# .env is never committed to git.

# Where the server listens (Nginx forwards the domain to this address)
PORT=3000
HOST=127.0.0.1

# SMS panel: "parsgreen" for real SMS, "console" to print codes in the log (testing)
SMS_PROVIDER=console

# Parsgreen web-service key (from the «وب‌سرویس» menu in the Parsgreen panel)
PARSGREEN_API_KEY=
# Adds your panel's company name to the OTP message
PARSGREEN_ADD_NAME=true

# Code lifetime and limits
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_IP_SENDS_PER_HOUR=10
OTP_MOBILE_SENDS_PER_DAY=8

# Random secret used to hash codes in memory. Any long random text.
OTP_SECRET=change-me-to-a-long-random-string

# Set to true when running behind Nginx so rate limits see the real visitor IP
TRUST_PROXY=true

# Economic-number inquiry service. Put the full URL here (kept only on the server).
# Leave empty to show demo tax files instead.
INQUIRY_URL=
INQUIRY_MAX_COUNTER=10
INQUIRY_CONCURRENCY=10
INQUIRY_TIMEOUT_MS=8000
INQUIRY_CACHE_MINUTES=10
# The service only answers Iranian IPs. Set this to send requests through the SSH
# tunnel opened from a machine in Iran (docs/relay-fa.md), e.g. 127.0.0.1:9101
INQUIRY_TUNNEL=

# How long a login stays valid without activity (minutes)
SESSION_MINUTES=60

# Optional name shown after login (empty = generic welcome)
DEMO_USER_NAME=
